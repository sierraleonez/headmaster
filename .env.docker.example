# Runtime environment for the containers. Copy to .env.docker and fill in.
#   cp .env.docker.example .env.docker
#
# APP_KEY is required. Generate one with:
#   docker compose run --rm --no-deps app php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"

APP_NAME=HeadMaster
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# Host port the site is published on.
HEADMASTER_PORT=8080

# Container logs belong on stdout, not in a file inside the image.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# What the MySQL container creates on first boot...
MYSQL_DATABASE=headmaster
MYSQL_USER=headmaster
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ...and what Laravel connects with. Keep the three in step.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=headmaster
DB_USERNAME=headmaster
DB_PASSWORD=change-me

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# The planning assistant. Leave the key blank to run without the chatbot.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=300
